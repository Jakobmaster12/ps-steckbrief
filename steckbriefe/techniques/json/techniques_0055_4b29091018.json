  "stufe1_extract": {
    "strings": [
      "Enter TikTok username",
      ")\r\n    \r\n    try {\r\n        Write-Host \"`nFetching @$Username...\" -ForegroundColor Yellow\r\n        \r\n        $html = (Invoke-WebRequest -Uri \"https://www.tiktok.com/@$Username\" -Headers @{\r\n            \"User-Agent\" = \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) Chrome/120.0.0.0\"\r\n        }).Content\r\n        \r\n        $data = @{\r\n            username = [regex]::Match($html, ",
      "uniqueId",
      "([^",
      "').Groups[1].Value\r\n            nickname = [regex]::Match($html, '",
      "').Groups[1].Value\r\n            userId = [regex]::Match($html, '",
      "(\\d+)",
      ").Groups[1].Value\r\n            verified = [regex]::Match($html, ",
      "verified",
      ").Groups[1].Value\r\n            followers = [regex]::Match($html, ",
      "followerCount",
      ").Groups[1].Value\r\n            following = [regex]::Match($html, ",
      "followingCount",
      ").Groups[1].Value\r\n            likes = [regex]::Match($html, ",
      "heartCount",
      ").Groups[1].Value\r\n            videos = [regex]::Match($html, ",
      "videoCount",
      ").Groups[1].Value\r\n            friends = [regex]::Match($html, ",
      "friendCount",
      ").Groups[1].Value\r\n            private = [regex]::Match($html, ",
      "privateAccount",
      ").Groups[1].Value\r\n            created = [regex]::Match($html, ",
      "createTime",
      ").Groups[1].Value\r\n            bio = [regex]::Match($html, ",
      "webapp\\.user-detail",
      "signature",
      "').Groups[1].Value\r\n        }\r\n        \r\n        if (-not $data.username -or -not $data.followers) {\r\n            throw ",
      "\r\n        }\r\n        \r\n        Write-Host (",
      " + ",
      "*50) -ForegroundColor Cyan\r\n        Write-Host ",
      " -ForegroundColor Cyan\r\n        Write-Host (",
      "*50) -ForegroundColor Cyan\r\n        \r\n        Write-Host ",
      " -ForegroundColor Green\r\n        @(\r\n            @(",
      "@$($data.username)",
      "Yellow",
      "Display Name",
      "User ID",
      "Verified",
      "true",
      "✓ Yes",
      "✗ No",
      "Green",
      "Red",
      "  $($_[0]): ",
      "`nSTATISTICS:",
      "Followers",
      "Following",
      "Total Likes",
      "Videos",
      "Friends",
      " -replace ",
      "likes",
      "  ${_}: ",
      "`nACCOUNT SETTINGS:",
      "  Private Account: ",
      "Yes",
      "No (Public)",
      "  Account Created: ",
      "MMMM dd, yyyy",
      "`nBIO:"
    ],
