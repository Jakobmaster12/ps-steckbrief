      ") { return ",
      " }\n\tif ($IsLinux) {\n\t\t$Name = $PSVersionTable.OS\n\t\tif ($Name -like ",
      ") {\n\t\t\tif ([System.Environment]::Is64BitOperatingSystem) { return ",
      " } else { return ",
      " }\n\t\t} elseif ($Name -like ",
      " }\n\t\t} elseif ([System.Environment]::Is64BitOperatingSystem) { return ",
      " }\n\t}\n}\n\nfunction GetCPUTemperature {\n\t$temp = 99999.9 # unsupported\n\tif ($IsLinux) {\n\t\tif (Test-Path ",
      " -pathType leaf) {\n\t\t\t[int]$IntTemp = Get-Content ",
      "\n\t\t\t$temp = [math]::round($IntTemp / 1000.0, 1)\n\t\t}\n\t} else {\n\t\t$objects = Get-WmiObject -Query ",
      " -Namespace ",
      "\n\t\tforeach ($object in $objects) {\n\t\t\t$highPrec = $object.HighPrecisionTemperature\n\t\t\t$temp = [math]::round($highPrec / 100.0, 1)\n\t\t}\n\t}\n\treturn $temp\n}\n\ntry {\n\tWrite-Progress ",
      "\n\t$status = ",
      "\n\t$arch = GetCPUArchitecture\n\tif ($IsLinux) {\n\t\t$cpuName = ",
      "\n\t\t$arch = ",
      "\n\t\t$deviceID = ",
      "\n\t\t$speed = ",
      "\n\t\t$socket = ",
      "\n\t} else {\n\t\t$details = Get-WmiObject -Class Win32_Processor\n\t\t$cpuName = $details.Name.trim()\n\t\t$arch = ",
      "\n\t}\n\t$cores = [System.Environment]::ProcessorCount\n\t$celsius = GetCPUTemperature\n\tif ($celsius -eq 99999.9) {\n\t\t$temp = ",
