    "deobfuskiert_auszug": "﻿<#\n.SYNOPSIS\n\tChanges to /etc \n.DESCRIPTION\n\tThis PowerShell script changes the current working directory to the /etc directory.\n.EXAMPLE\n\tPS> ./cd-etc.ps1\n\t📂C:\\Windows\\System32\\drivers\\etc entered, has 5 files and 0 folders.\n.LINK\n\thttps://github.com/fleschutz/PowerShell\n.NOTES\n\tAuthor: Markus Fleschutz | License: CC0\n#>\n\n#requires -version 5.1\n\ntry {\n\tif ($IsLinux -or $IsMacOS) {\n\t\t$path = \"/etc\"\n\t} else {\n\t\t$path = Resolve-Path \"$env:WINDIR\\System32\\drivers\\etc\"\n\t}\n\tif (-not(Test-Path \"$path\" -pathType container)) {\n\t\tthrow \"No 'etc' folder found at: $path\"\n\t}\n\tSet-Location \"$path\"\n\t$files = Get-ChildItem $path -attributes !Directory\n\t$folders = Get-ChildItem $path -attributes Directory\n\t\"📂$path entered, has $($files.Count) files and $($folders.Count) folders.\"\n\texit 0 # success\n} catch {\n\t\"⚠️ ERROR: $($Error[0])\"\n\texit 1\n}\n",
